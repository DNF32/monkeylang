let flip = fn(f) {
  return fn(x, y) { return f(y, x); };
};

let curry = fn(f, x) {
  return fn(y) { return f(x, y); };
};

let compose = fn(f, g) {
  return fn(x) { return f(g(x)); };
};

let add = fn(x, y) { return x + y; };
let subtract = fn(x, y) { return x - y; };
let multiply = fn(x, y) { return x * y; };

let add10 = curry(add, 10);
let sub5 = curry(flip(subtract), 5);
let triple = curry(multiply, 3);

let transform = compose(add10, compose(sub5, triple));

let fib = fn(n) {
  if (n < 2) { return n; }
  return fib(n - 1) + fib(n - 2);
};

let a = transform(fib(7));
let b = transform(fib(6));
a + b;
